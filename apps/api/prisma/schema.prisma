generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
}

enum GroupInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ContributionStatus {
  PENDING
  POSTED
  REJECTED
  REVERSED
}

enum LoanStatus {
  REQUESTED
  APPROVED
  DISBURSED
  ACTIVE
  OVERDUE
  CLOSED
  REJECTED
  DEFAULTED
}

enum RepaymentStatus {
  PENDING
  POSTED
  REVERSED
}

enum ScheduleFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ObligationStatus {
  PENDING
  OVERDUE
  PAID
  WAIVED
}

enum NotificationType {
  CONTRIBUTION_DUE
  CONTRIBUTION_OVERDUE
  CONTRIBUTION_POSTED
  LOAN_STATUS
  SYSTEM
}

enum WalletType {
  USER
  GROUP
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  CONTRIBUTION
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  ADJUSTMENT
  FEE
  INTEREST
}

enum TransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  phone     String?  @unique
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdGroups SavingsGroup[]    @relation("GroupCreator")
  memberships   GroupMembership[]
  wallets       Wallet[]
  reviewedContributions Contribution[] @relation("ContributionReviewedBy")
  createdSchedules ContributionSchedule[] @relation("ScheduleCreatedBy")
  updatedSchedules ContributionSchedule[] @relation("ScheduleUpdatedBy")
  createdGoals SavingsGoal[] @relation("GoalCreatedBy")
  createdGoalMilestones SavingsGoalMilestone[] @relation("GoalMilestoneCreatedBy")
  notifications Notification[]
  notificationPreference NotificationPreference?
  sentGroupInvitations GroupInvitation[] @relation("GroupInvitationSentBy")
  acceptedGroupInvitations GroupInvitation[] @relation("GroupInvitationAcceptedBy")

  @@index([createdAt])
}

model SavingsGroup {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User              @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships GroupMembership[]
  wallets     Wallet[]
  schedules   ContributionSchedule[]
  goals       SavingsGoal[]
  invitations GroupInvitation[]

  @@index([createdById])
  @@index([createdAt])
}

model GroupMembership {
  id        String           @id @default(uuid())
  userId    String
  groupId   String
  role      MembershipRole   @default(MEMBER)
  status    MembershipStatus @default(PENDING)
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  group         SavingsGroup    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  contributions Contribution[]
  loans         Loan[]
  repayments    LoanRepayment[] @relation("RepaymentPayerMembership")
  obligations   ContributionObligation[]

  @@unique([userId, groupId])
  @@index([groupId, status])
  @@index([userId, status])
}

model GroupInvitation {
  id               String                @id @default(uuid())
  groupId          String
  invitedById      String
  invitedEmail     String
  role             MembershipRole        @default(MEMBER)
  status           GroupInvitationStatus @default(PENDING)
  tokenHash        String                @unique
  pendingKey       String?               @unique
  message          String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  acceptedByUserId String?
  lastSentAt       DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  group            SavingsGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy        User         @relation("GroupInvitationSentBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy       User?        @relation("GroupInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([groupId, status, createdAt])
  @@index([groupId, invitedEmail])
  @@index([invitedEmail, status])
  @@index([expiresAt, status])
}

model Contribution {
  id            String             @id @default(uuid())
  membershipId  String
  amount        Decimal            @db.Decimal(18, 2)
  currency      String             @default("KES")
  status        ContributionStatus @default(PENDING)
  contributedAt DateTime
  reference     String?            @unique
  notes         String?
  reviewedById String?
  reviewReason String?
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  membership   GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  reviewedBy   User?           @relation("ContributionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  transactions Transaction[]
  settledObligations ContributionObligation[] @relation("ObligationContribution")

  @@index([membershipId, contributedAt])
  @@index([status, contributedAt])
}

model Loan {
  id                   String     @id @default(uuid())
  borrowerMembershipId String
  principalAmount      Decimal    @db.Decimal(18, 2)
  interestRate         Decimal    @db.Decimal(5, 2)
  termMonths           Int
  purpose              String?
  disbursedAt          DateTime?
  dueAt                DateTime?
  status               LoanStatus @default(REQUESTED)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  borrowerMembership GroupMembership @relation(fields: [borrowerMembershipId], references: [id], onDelete: Restrict)
  repayments         LoanRepayment[]
  transactions       Transaction[]

  @@index([borrowerMembershipId, status])
  @@index([status, createdAt])
}

model LoanRepayment {
  id                 String          @id @default(uuid())
  loanId             String
  paidByMembershipId String?
  amount             Decimal         @db.Decimal(18, 2)
  paidAt             DateTime
  status             RepaymentStatus @default(PENDING)
  reference          String?         @unique
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  loan             Loan             @relation(fields: [loanId], references: [id], onDelete: Restrict)
  paidByMembership GroupMembership? @relation("RepaymentPayerMembership", fields: [paidByMembershipId], references: [id], onDelete: SetNull)
  transactions     Transaction[]

  @@index([loanId, paidAt])
  @@index([paidByMembershipId])
}

model Wallet {
  id        String     @id @default(uuid())
  type      WalletType
  userId    String?
  groupId   String?
  currency  String     @default("KES")
  balance   Decimal    @default(0) @db.Decimal(18, 2)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  group        SavingsGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@unique([userId, currency])
  @@unique([groupId, currency])
  @@index([type])
}

model Transaction {
  id                String            @id @default(uuid())
  walletId          String
  contributionId    String?
  loanId            String?
  loanRepaymentId   String?
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  amount            Decimal           @db.Decimal(18, 2)
  currency          String            @default("KES")
  occurredAt        DateTime
  description       String?
  externalReference String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  contribution  Contribution?  @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  loan          Loan?          @relation(fields: [loanId], references: [id], onDelete: SetNull)
  loanRepayment LoanRepayment? @relation(fields: [loanRepaymentId], references: [id], onDelete: SetNull)

  @@index([walletId, occurredAt])
  @@index([contributionId])
  @@index([loanId])
  @@index([loanRepaymentId])
  @@index([type, status])
}

model ContributionSchedule {
  id            String            @id @default(uuid())
  groupId       String
  createdById   String
  updatedById   String?
  name          String
  amount        Decimal           @db.Decimal(18, 2)
  currency      String            @default("KES")
  frequency     ScheduleFrequency
  dueDayOfWeek  Int?
  dueDayOfMonth Int?
  graceDays     Int               @default(0)
  startsOn      DateTime
  endsOn        DateTime?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  group       SavingsGroup            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy   User                    @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?                   @relation("ScheduleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  obligations ContributionObligation[]

  @@index([groupId, isActive])
  @@index([startsOn, endsOn])
}

model ContributionObligation {
  id                 String           @id @default(uuid())
  scheduleId         String
  membershipId       String
  dueDate            DateTime
  expectedAmount     Decimal          @db.Decimal(18, 2)
  currency           String           @default("KES")
  status             ObligationStatus @default(PENDING)
  paidAt             DateTime?
  paidContributionId String?
  waivedReason       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  schedule         ContributionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  membership       GroupMembership      @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  paidContribution Contribution?        @relation("ObligationContribution", fields: [paidContributionId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, membershipId, dueDate])
  @@index([membershipId, dueDate])
  @@index([status, dueDate])
}

model SavingsGoal {
  id           String   @id @default(uuid())
  groupId      String
  createdById  String
  name         String
  description  String?
  targetAmount Decimal  @db.Decimal(18, 2)
  currency     String   @default("KES")
  startDate    DateTime
  targetDate   DateTime
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group     SavingsGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy User         @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  milestones SavingsGoalMilestone[]

  @@index([groupId, isArchived, targetDate])
  @@index([createdById])
}

model SavingsGoalMilestone {
  id           String   @id @default(uuid())
  goalId        String
  createdById   String
  name          String
  targetAmount  Decimal  @db.Decimal(18, 2)
  dueDate       DateTime
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goal       SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("GoalMilestoneCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([goalId, dueDate])
  @@index([createdById])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  metadata   Json?
  dedupeKey  String?          @unique
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
}

model NotificationPreference {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  contributionDueEnabled       Boolean  @default(true)
  contributionOverdueEnabled   Boolean  @default(true)
  contributionPostedEnabled    Boolean  @default(true)
  loanStatusEnabled            Boolean  @default(true)
  systemEnabled                Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
